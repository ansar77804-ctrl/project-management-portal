{
  "version": 2,
  "builds": [
    { "src": "frontend/package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://project-management-portal.railway.internal/:path*"
    }
  ],
  "routes": [
    { "src": "^/(.*)$", "dest": "/frontend/dist/$1" }
  ]
}
