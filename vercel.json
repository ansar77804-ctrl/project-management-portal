{
  "version": 2,
  "builds": [
    { "src": "frontend/package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } }
  ],
  "routes": [
    {
      "src": "^/api/(.*)$",
      "dest": "https://project-management-portal.railway.internal/$1",
      "headers": { "x-forwarded-host": "$host" }
    },
    { "src": "^/(.*)$", "dest": "/frontend/dist/$1" }
  ]
}
